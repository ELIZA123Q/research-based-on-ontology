      "additionalProperties": true,
      "properties": {
        "ontology_manifest": {"type": "object"},
        "concepts": {"type": "object"},
        "objects": {"type": "object"},
        "relations": {"type": "object"},
        "actions": {"type": "object"},
        "reasoning": {"type": "object"},
        "evidence": {"type": "object"},
        "governance": {"type": "object"},
        "optimization_handoff": {"type": "object"}
      }
    },
