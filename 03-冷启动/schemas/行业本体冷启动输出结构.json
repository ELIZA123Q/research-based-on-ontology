            "properties": {
              "module_name": {
                "type": "string"
              },
              "omission_reason": {
                "type": "string"
              },
              "mvo_impact": {
                "type": "string"
              }
            }
          }
        },
        "anti_random_check": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "check",
              "result",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "check": {
                "type": "string"
