    "candidate_research_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "primary_industry",
          "segments",
          "scope_type",
          "rationale",
          "confidence",
          "default_assumption",
          "needs_confirmation"
        ],
        "additionalProperties": true,
        "properties": {
          "primary_industry": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_type": {
            "type": "string",
            "enum": [
              "industry",
              "supply_chain",
              "product_track",
              "company_research",
              "policy_theme",
              "macro_theme",
              "event_theme",
              "uncertain"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default_assumption": {
            "type": "boolean"
          },
          "needs_confirmation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "template_application": {
      "type": "object",
      "required": [
        "selected_template_id",
        "selected_reason",
        "confidence",
        "primary_research_question",
        "reference_models",
