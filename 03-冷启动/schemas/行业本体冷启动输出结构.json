            "supply_chain",
            "product_track",
            "company_research",
            "policy_theme",
            "macro_theme",
            "event_theme",
            "uncertain"
          ]
        },
        "focus_description": {
          "type": "string"
        },
        "primary_research_question": {
          "type": "string"
        },
        "user_input_summary": {
          "type": "string"
