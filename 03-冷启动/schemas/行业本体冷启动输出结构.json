            "additionalProperties": true,
            "properties": {
              "anchor_type": {
                "type": "string",
                "enum": [
                  "industry",
                  "supply_chain",
                  "product_track",
                  "company",
                  "product",
                  "policy",
                  "macro_variable",
                  "event",
                  "asset",
                  "other"
