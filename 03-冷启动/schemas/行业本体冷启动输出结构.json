              "module_name": {
                "type": "string"
              },
              "template_source": {
                "type": "string"
              },
              "applied_to_output_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "customized_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module_name",
              "customization_reason",
              "customization_summary"
