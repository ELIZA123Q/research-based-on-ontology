      "additionalProperties": true,
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "industry",
            "supply_chain",
            "product_track",
            "company_research",
            "policy_theme",
            "macro_theme",
            "event_theme",
            "uncertain"
