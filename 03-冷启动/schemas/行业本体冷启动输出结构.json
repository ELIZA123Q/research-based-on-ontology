        "asset_clues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impacted_industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_confirmation": {
          "type": "array",
          "items": {
            "type": "string"
          }
