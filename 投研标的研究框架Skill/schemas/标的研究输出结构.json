{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "标的研究输出",
  "type": "object",
  "required": ["标的基本画像", "当前研究触发点", "核心投资问题", "关键状态变量", "证据与验证信号", "传导逻辑", "估值与资产影响", "结论", "风险提示"],
  "additionalProperties": false,
  "properties": {
    "标的基本画像": {
      "type": "object",
      "required": ["标的名称", "标的类型", "所属产业或行业", "核心业务或研究范围", "收入来源", "利润来源", "产业链位置", "主要相关主体"],
      "additionalProperties": false,
      "properties": {
        "标的名称": { "type": "string" },
        "标的类型": { "type": "string", "enum": ["Company", "Industry", "Segment", "Product", "Material", "PolicyTheme", "EventTheme", "Asset", "Unknown"] },
        "所属产业或行业": { "type": "string" },
        "核心业务或研究范围": { "type": "string" },
        "收入来源": { "type": "string" },
        "利润来源": { "type": "string" },
        "产业链位置": { "type": "string" },
        "主要相关主体": {
          "type": "object",
          "required": ["客户", "供应商", "竞争对手", "其他相关主体"],
          "additionalProperties": false,
          "properties": {
            "客户": { "type": "array", "items": { "type": "string" } },
            "供应商": { "type": "array", "items": { "type": "string" } },
            "竞争对手": { "type": "array", "items": { "type": "string" } },
            "其他相关主体": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "当前研究触发点": {
      "type": "object",
      "required": ["触发事件", "市场关注点", "核心分歧", "当前研究必要性", "来源证据"],
      "additionalProperties": false,
      "properties": {
        "触发事件": { "type": "string" },
        "市场关注点": { "type": "string" },
        "核心分歧": { "type": "string" },
        "当前研究必要性": { "type": "string" },
        "来源证据": { "type": "array", "items": { "type": "string" } }
      }
    },
    "核心投资问题": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["问题", "对应状态变量", "当前回答", "待验证点"],
        "additionalProperties": false,
        "properties": {
          "问题": { "type": "string" },
          "对应状态变量": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "当前回答": { "type": "string" },
          "待验证点": { "type": "string" }
        }
      }
    },
    "关键状态变量": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["状态变量", "当前状态", "变化方向", "重要性", "依据"],
        "additionalProperties": false,
        "properties": {
          "状态变量": { "type": "string" },
          "当前状态": { "type": "string" },
          "变化方向": { "type": "string", "enum": ["改善", "恶化", "稳定", "分化", "未知"] },
          "重要性": { "type": "string", "enum": ["高", "中", "低"] },
          "依据": { "type": "string" }
        }
      }
    },
    "证据与验证信号": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["证据或信号", "对应状态变量", "支持或反证", "数据来源", "跟踪频率"],
        "additionalProperties": false,
        "properties": {
          "证据或信号": { "type": "string" },
          "对应状态变量": { "type": "string" },
          "支持或反证": { "type": "string", "enum": ["支持", "反证", "跟踪", "阻断", "未知"] },
          "数据来源": { "type": "string" },
          "跟踪频率": { "type": "string" }
        }
      }
    },
    "传导逻辑": {
      "type": "object",
      "required": ["事件或变化", "影响的状态变量", "对业务的影响", "对财务的影响", "对估值或市场预期的影响", "边界条件"],
      "additionalProperties": false,
      "properties": {
        "事件或变化": { "type": "string" },
        "影响的状态变量": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "对业务的影响": { "type": "string" },
        "对财务的影响": { "type": "string" },
        "对估值或市场预期的影响": { "type": "string" },
        "边界条件": { "type": "string" }
      }
    },
    "估值与资产影响": {
      "type": "object",
      "required": ["收入影响", "利润影响", "估值影响", "市场可能反映路径", "市场预期差", "合规边界"],
      "additionalProperties": false,
      "properties": {
        "收入影响": { "type": "string" },
        "利润影响": { "type": "string" },
        "估值影响": { "type": "string" },
        "市场可能反映路径": { "type": "string" },
        "市场预期差": { "type": "string" },
        "合规边界": { "type": "string" }
      }
    },
    "结论": {
      "type": "object",
      "required": ["当前判断", "判断级别", "成立条件", "反证条件", "后续跟踪重点"],
      "additionalProperties": false,
      "properties": {
        "当前判断": { "type": "string" },
        "判断级别": { "type": "string", "enum": ["单来源候选", "多来源候选", "历史支持模板候选", "观察中", "待验证", "不成立"] },
        "成立条件": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "反证条件": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "后续跟踪重点": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "风险提示": {
      "type": "object",
      "required": ["基本面风险", "行业风险", "估值风险", "数据不确定性"],
      "additionalProperties": false,
      "properties": {
        "基本面风险": { "type": "array", "items": { "type": "string" } },
        "行业风险": { "type": "array", "items": { "type": "string" } },
        "估值风险": { "type": "array", "items": { "type": "string" } },
        "数据不确定性": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "估值与资产影响": {
          "properties": {
            "合规边界": {
              "pattern": "不生成买卖建议|不输出买卖建议|不构成投资建议"
            }
          }
        }
      }
    }
  ]
}
